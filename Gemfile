source "https://rubygems.org"

# Versão do github-pages usada pelo GitHub Pages
gem "github-pages", group: :jekyll_plugins

# Plugins recomendados e suportados pelo GitHub Pages
gem "jekyll-seo-tag"
gem "jekyll-feed"
gem "jekyll-sitemap"

# Servidor web WEBrick (necessário para Ruby 3.0+)
gem "webrick"
